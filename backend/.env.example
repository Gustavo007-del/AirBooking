DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
# Local development: no PostgreSQL or Redis service is needed.
DATABASE_URL=sqlite:///db.sqlite3
# Deployment: set DATABASE_URL=postgres://airbooking:your-password@localhost:5432/airbooking
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:8000
FRONTEND_URL=http://localhost:5173
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=1
RESERVATION_MINUTES=15
REDIS_URL=redis://localhost:6379/0
# SQLite + DEBUG runs Celery tasks inline by default (console email).
# For real background workers, uncomment both:
# CELERY_TASK_ALWAYS_EAGER=false
# CELERY_BROKER_URL=redis://localhost:6379/1
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=Air Booking <noreply@example.com>
SEND_REJECTION_EMAIL=true
# Leave the key blank for saved flights only. Add your own key in .env.
# Auto-selects AirLabs when a key is set. Uncomment to force manual status.
# FLIGHT_STATUS_PROVIDER=manual
AIRLABS_API_KEY=
AIRLABS_LOOKUP_CACHE_SECONDS=60
AIRLABS_TIMETABLE_CACHE_SECONDS=21600
# These seats belong only to the Air Booking simulation.
AIRLABS_SIMULATION_SEATS=24
FLIGHT_STATUS_CACHE_SECONDS=300

